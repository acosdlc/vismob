@@ -0,0 +1,35 @@
+import { render, screen } from "@testing-library/react";
+import { describe, expect, it } from "vitest";
+import type { Project } from "@/lib/data/projects.seed";
+import { SEED_SETTINGS } from "@/lib/data/settings.seed";
+import { Hero } from "./Hero";
+
+/** The hero project as getHeroProject() returns it after the workshop renamed the model in Catalog. */
+const HERO = {
+  slug: "capitonat-cluj",
+  ticketNo: "0123",
+  title: "Pat capitonat pentru un dormitor din Cluj",
+  modelId: "capitonat",
+  modelName: "Capitonat clasic „Ștefan”",
+  widthCm: 180,
+  lengthCm: 200,
+  materialLabel: "Catifea, verde sticlă",
+  baseLabel: "Ladă de depozitare",
+  extras: [],
+  city: "Cluj-Napoca",
+  deliveredLabel: "Cluj-Napoca, martie 2026",
+  featured: false,
+  hero: true,
+} satisfies Project;
+
+describe("Hero", () => {
+  it("prints the model's name on the ticket, not its id", () => {
+    render(<Hero settings={SEED_SETTINGS} hero={HERO} />);
+    expect(screen.getByText("Model").nextElementSibling).toHaveTextContent("Capitonat clasic „Ștefan”");
+  });
+
+  it("shows no ticket without a hero project", () => {
+    render(<Hero settings={SEED_SETTINGS} hero={null} />);
+    expect(screen.queryByText("FIȘĂ PROIECT")).not.toBeInTheDocument();
+  });
+});

+/**
+ * The letters Romanian writes with a diacritic, each with the forms a name reaches the database
+ * in: plain (typed without diacritics), comma-below, and the cedilla of older keyboard layouts
+ * (ş U+015F, ţ U+0163), which looks the same on screen and is written as an escape for that reason.
+ */
+const LETTER_FORMS = ["aăâ", "iî", "sș\u015F", "tț\u0163"] as const;
+
+/** What a regular expression reads, plus the double quote, which PostgREST reads around a whole value. */
+const PATTERN_SYNTAX = /[.*+?^${}|[\]"]/;
+
+/**
+ * The search as a regular expression for PostgREST's `imatch` (Postgres `~*`) in which „Stirbu”,
+ * „Știrbu” and „Ştirbu” are one name: `ilike` compares letter by letter, while clients and the
+ * workshop type a name with or without its diacritics. Every other character stands for itself
+ * (sanitizeSearch already dropped `,` `(` `)` `%` and the backslash). Null when the search has
+ * none of those letters, so `ilike` already says everything.
+ */
+export function nameSearchPattern(search: string): string | null {
+  const letters = Array.from(search.normalize("NFC"));
+  const formsOf = (letter: string) => LETTER_FORMS.find((forms) => Array.from(forms).includes(letter.toLowerCase()));
+  if (!letters.some(formsOf)) return null;
+  return letters
+    .map((letter) => {
+      const forms = formsOf(letter);
+      if (forms) return `[${forms}${forms.toUpperCase()}]`;
+      return PATTERN_SYNTAX.test(letter) ? `\\${letter}` : letter;
+    })
+    .join("");
+}

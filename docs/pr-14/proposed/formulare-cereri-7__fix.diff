+/**
+ * The letters Romanian writes with a diacritic, each with every form it reaches the database in:
+ * plain (typed without diacritics), comma-below, and the cedilla of old keyboard layouts.
+ */
+const LETTER_FORMS = ["aăâ", "iî", "sșş", "tțţ"] as const;
+
+/**
+ * The search as a regular expression for PostgREST's `imatch` (Postgres `~*`), in which „Stirbu”,
+ * „Știrbu” and „Ştirbu” are one name: clients type their names either way, and so does the
+ * workshop. Every other character stands for itself; the ones a regular expression or PostgREST
+ * reads are escaped (sanitizeSearch already dropped `,` `(` `)` `%` and the backslash). Null when
+ * the search has none of those letters, so `ilike` already says everything.
+ */
+export function nameSearchPattern(search: string): string | null {
+  const letters = Array.from(search.normalize("NFC"));
+  const formsOf = (letter: string) => LETTER_FORMS.find((forms) => forms.includes(letter.toLowerCase()));
+  if (!letters.some(formsOf)) return null;
+  return letters
+    .map((letter) => {
+      const forms = formsOf(letter);
+      if (forms) return `[${forms}${forms.toUpperCase()}]`;
+      return /[.*+?^${}|[\]"]/.test(letter) ? `\\${letter}` : letter;
+    })
+    .join("");
+}

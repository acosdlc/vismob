+
+  it("finds a name whichever way its diacritics were typed: plain, comma-below or cedilla", () => {
+    /** The regular expression of the name term the search adds (`imatch` is Postgres `~*`). */
+    const namePattern = (search: string) => {
+      const q = fakeQuery();
+      applyLeadFilters(q, { period: "all", q: search }, NOW);
+      const term = q.calls[0][1].split(",").find((part) => part.startsWith("name.imatch."));
+      expect(term, `the or-filter of „${search}” has a name.imatch term`).toBeDefined();
+      return term!.slice("name.imatch.".length);
+    };
+    const finds = (search: string, name: string) => new RegExp(namePattern(search), "i").test(name);
+
+    // The workshop types without diacritics, the client wrote the name with them.
+    expect(finds("Stirbu", "Andreea Știrbu")).toBe(true);
+    expect(finds("tirlea-brancusi", "Ștefan Țîrlea-Brâncuși")).toBe(true);
+    // The other way round, and the cedilla letters of old keyboard layouts.
+    expect(finds("Știrbu", "Andreea Stirbu")).toBe(true);
+    expect(finds("Știrbu", "Andreea Ştirbu")).toBe(true);
+    expect(finds("ŢURCANU", "D'Artagnan Țurcanu")).toBe(true);
+    // Still the same letters in the same order, and nothing a regular expression reads.
+    expect(finds("Stirbu", "Andreea Sturbu")).toBe(false);
+    expect(finds("a.b", "Axb")).toBe(false);
+    expect(finds("a*", "Bob")).toBe(false);
+    // A quote is escaped: PostgREST reads a term in double quotes as a quoted value and drops them.
+    expect(namePattern('"Stirbu"')).toMatch(/^\\"/);
+    expect(finds('"Stirbu"', "Andreea Știrbu")).toBe(false);
+  });
+

# Names only. Values live in the Vercel project's environment variables.
# The Vercel Supabase integration sets these three by itself.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Added by hand in Vercel when the project sends email.
RESEND_API_KEY=

# Public site URL (https://domeniu.ro). Previews fall back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=

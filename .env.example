# Names only. Values live in the Vercel project's environment variables.
# The Vercel Supabase integration sets these three by itself.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# Request forms (PR-2). Added by hand on the Vercel project's Environment
# Variables page; the code works without them (emails are logged, the
# anti-spam token check fails closed with a clear message).
RESEND_API_KEY=
EMAIL_FROM=
NOTIFY_EMAIL=
NOTIFY_DRY_RUN=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
IP_HASH_SALT=
FORM_HMAC_SECRET=
# Content revalidation (PR-5): what the Supabase Database Webhooks send as x-revalidate-secret to /api/revalidate.
REVALIDATE_SECRET=
# Vercel Cron (PR-10): Vercel sends it as `Authorization: Bearer …` to /api/cron/[job]; random, 32 bytes.
CRON_SECRET=

# Public site URL (https://domeniu.ro). Previews fall back to the Vercel URL.
NEXT_PUBLIC_SITE_URL=

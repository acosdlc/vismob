{
  "about": "Catalog of Supabase and Vercel connector tools for .claude/hooks/guard.mjs. rw: r = read, w = write, x = destructive / hard to undo / costs money. \"project\" and \"team\" list the parameters that name a project or a team (\"!\" = required). Only a \"project\" parameter can show that a call is on this project.",
  "catalogued": "2026-10-14",
  "settings": {
    "auto_allow_reads": true,
    "auto_allow_writes": false
  },
  "bootstrap_writes": {
    "supabase": [],
    "vercel": [
      "create_git_project"
    ]
  },
  "denied_always": {
    "supabase": {
      "create_project": "databases in this organization are created by the user in the Vercel dashboard (Storage). See the setup-project skill."
    },
    "vercel": {
      "create_project": "a repository has exactly one Vercel project, linked with create_git_project during setup.",
      "import-claude-design-from-url": "it creates or updates a Vercel project outside this repository's pin.",
      "deploy_to_vercel": "it deploys outside this repository's pinned project. Deployments here come from pushing to GitHub.",
      "get_shared_env_var": "shared environment variables belong to the whole team, and this returns their decrypted values."
    }
  },
